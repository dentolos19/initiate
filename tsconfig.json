{
  "include": ["src", "scripts", "tests", "*.config.ts", ".cloudflare/types"],
  "compilerOptions": {
    "target": "es2023",
    "lib": ["dom", "dom.iterable", "es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "paths": {
      "#/*": ["./src/*"]
    },
    "types": ["bun", "vite/client"],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": true
  }
}
