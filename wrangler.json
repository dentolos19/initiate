{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "d910f54eba4cf3d1634aa41c3d9a93bc",
  "name": "initiate",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 3000,
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
  "routes": [
    {
      "pattern": "initiate.dennise.me",
      "custom_domain": true,
    },
    {
      "pattern": "initiate.global",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "0981b552-4d0d-47da-8759-61b61ac8b927",
      "database_name": "initiate",
      "migrations_dir": "migrations",
      "migrations_pattern": "migrations/*/migration.sql",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATIONS",
        "queue": "initiate-notifications",
      },
    ],
    "consumers": [
      {
        "queue": "initiate-notifications",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "initiate-notifications-dead-letter",
      },
    ],
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "initiate",
    },
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "initiate-search",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MESSAGING",
        "class_name": "Messaging",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Messaging"],
    },
  ],
  "workflows": [
    {
      "name": "initiate-synchronizer",
      "binding": "SYNCHRONIZE",
      "class_name": "SynchronizeWorkflow",
    },
  ],
}
